page {
  height: 100%;
  min-height: 100vh;
  overflow: hidden;
  overscroll-behavior: none;
  background: #ffffff;
  color: #1f211c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
picker,
slider {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}
