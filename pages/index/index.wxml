            <label class="parameter-row"><text>滤杯</text><input id="recipe-dripper" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" placeholder="例：Hario V60" value="{{recipeForm.dripper}}" data-field="dripper" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" bindinput="onRecipeFormInput" /></label>
