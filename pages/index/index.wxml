<import src="../../templates/roaster-bean-detail.wxml" />
<import src="../../templates/flavor-page.wxml" />

<view
  class="edge-back-stage"
  style="--wallet-sticky-top:{{walletStickyTop}}px;--status-bar-height:{{statusBarHeight}}px;--navigation-bar-height:{{navigationBarHeight}}px;"
  capture-bind:touchstart="onPageEdgeTouchStart"
  capture-bind:touchmove="onPageEdgeTouchMove"
  capture-bind:touchend="onPageEdgeTouchEnd"
  capture-bind:touchcancel="onPageEdgeTouchCancel"
>
  <view
    wx:if="{{secondaryPageActive || showDataManager || showPrivacyAgreement}}"
    class="edge-back-system-gesture-guard"
    catchtouchstart="preventBubble"
    catchtouchmove="preventBubble"
    catchtouchend="preventBubble"
    catchtouchcancel="preventBubble"
    aria-hidden="true"
  ></view>
  <view wx:if="{{edgeBackActive}}" class="edge-back-previous" style="{{edgeBackPreviewStyle}}">
    <view wx:if="{{edgeBackPreview.real}}" class="app-shell edge-back-real-app {{edgeBackPreview.kind === 'dashboard' ? 'brew-home-active home-dashboard-active' : ''}} {{edgeBackPreview.kind === 'logs' ? 'brew-home-active' : ''}} {{edgeBackPreview.kind === 'brew' ? 'fixed-brew-screen' : ''}} {{edgeBackPreview.kind === 'mine' ? 'mine-page-active' : ''}}">
      <view class="tabs">
        <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.key === edgeBackPreview.tab ? 'active' : ''}}">
          <image wx:if="{{item.key === 'brew'}}" class="tab-logo" src="../../assets/icons/home-logo.png" mode="aspectFit"></image>
          <image wx:elif="{{item.key === 'beans'}}" class="tab-logo" src="../../assets/icons/beans-logo.png" mode="aspectFit"></image>
          <image wx:elif="{{item.key === 'roasters'}}" class="tab-logo" src="../../assets/icons/roasters-logo.png" mode="aspectFit"></image>
          <image wx:elif="{{item.key === 'mine'}}" class="tab-logo" src="../../assets/icons/mine-logo.png" mode="aspectFit"></image>
        </view>
      </view>
      <view wx:if="{{edgeBackPreview.kind === 'beans' && beanStockMode === 'active'}}" class="fixed-add-action">
        <view class="fixed-add-action-fill">+</view>
      </view>
      <view wx:if="{{edgeBackPreview.kind === 'recipes' && recipeLibraryMode === 'custom' && !recipeQuickImportMode}}" class="fixed-add-action">
        <view class="fixed-add-action-fill">+</view>
      </view>
      <view wx:if="{{edgeBackPreview.kind === 'flavor'}}" class="fixed-add-action">
        <view class="fixed-add-action-fill">+</view>
      </view>
      <scroll-view enable-passive="{{true}}" scroll-y="{{true}}" scroll-top="{{edgeBackPreview.scrollTop}}" class="content">
        <view wx:if="{{edgeBackPreview.kind === 'logs'}}" class="panel">
          <view class="brew-home">
            <view class="panel-header brew-home-header standard-spaced-header">
              <view class="header-back"><image class="back-button-image" src="../../assets/icons/back-arrow.png" mode="aspectFit"></image></view>
              <view class="header-title">
                <text class="panel-title">冲煮记录</text>
              </view>
            </view>

            <view class="brew-home-record-bar log-wallet">
              <view class="brew-log-calendar-filter wallet-sticky-sub">
                <view class="brew-log-calendar-toolbar">
                  <view class="brew-log-calendar-trigger">
                    <text>{{logDateFilter ? logDateFilterText : '全部记录'}}</text>
                    <text class="brew-log-calendar-arrow {{logCalendarOpen ? 'is-open' : ''}}">⌄</text>
                  </view>
                  <view class="brew-log-calendar-toolbar-meta">
                    <text>{{logTotalCount}} 条记录</text>
                    <view wx:if="{{logDateFilter}}" class="brew-log-show-all">查看全部记录</view>
                  </view>
                </view>

                <view wx:if="{{logCalendarOpen}}" class="brew-log-calendar-panel">
                  <view class="brew-log-calendar-month-nav">
                    <view class="brew-log-calendar-nav-button">‹</view>
                    <text>{{logCalendarTitle}}</text>
                    <view class="brew-log-calendar-nav-button">›</view>
                  </view>
                  <view class="brew-log-calendar-weekdays">
                    <text wx:for="{{logCalendarWeekdays}}" wx:key="*this">{{item}}</text>
                  </view>
                  <view class="brew-log-calendar-days">
                    <view wx:for="{{logCalendarDays}}" wx:key="dateKey" class="brew-log-calendar-day {{item.isCurrentMonth ? '' : 'is-outside'}} {{item.isSelected ? 'is-selected' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.hasRecords ? 'has-records' : ''}}">
                      <text>{{item.day}}</text>
                      <view wx:if="{{item.hasRecords}}" class="brew-log-calendar-record-dot"></view>
                    </view>
                  </view>
                </view>
              </view>

              <block wx:if="{{displayLogs.length > 0}}">
                <view class="bean-wallet-stack">
                  <view wx:for="{{displayLogs}}" wx:key="id" class="bean-swipe-row brew-log-swipe-row {{index === 0 ? 'is-first' : ''}} {{index === displayLogs.length - 1 ? 'is-last' : ''}} {{activeLogActionId === item.id ? 'actions-open' : ''}}">
                    <view class="bean-swipe-actions is-empty">
                      <view class="bean-card-action edit">编辑</view>
                      <view class="bean-card-action danger">删除</view>
                    </view>
                    <view class="card bean-card wallet-card {{logWalletOpenId === item.id ? 'is-open' : ''}}" style="{{item.cardArtStyle}}{{logSwipeMovingId === item.id ? logSwipeStyle : (activeLogActionId === item.id ? 'transform:translateX(-232rpx);' : '')}}">
                      <view class="wallet-card-head">
                        <view class="wallet-card-title">
                          <text class="wallet-card-name">{{item.productNameText}}</text>
                          <text class="wallet-card-roaster">{{item.subtitleText}}</text>
                        </view>
                      </view>
                      <view wx:if="{{logWalletOpenId === item.id}}" class="wallet-card-face log-wallet-face">
                        <view class="log-wallet-metrics">
                          <view wx:for="{{item.recordCardMetrics}}" wx:for-item="metric" wx:key="label" class="log-wallet-metric">
                            <text class="log-wallet-metric-value">{{metric.value}}</text>
                            <text class="log-wallet-metric-label">{{metric.label}}</text>
                          </view>
                        </view>
                        <text wx:if="{{item.notesText}}" class="wallet-card-line log-wallet-notes">{{item.notesText}}</text>
                        <view class="wallet-card-foot log-wallet-foot">
                          <view wx:if="{{item.rating > 0}}" class="brew-record-rating-stars">
                            <view wx:for="{{ratingOptions}}" wx:for-item="score" wx:for-index="scoreIndex" wx:key="*this" class="brew-record-rating-star {{item.ratingStarWidths[scoreIndex] > 0 && item.ratingStarWidths[scoreIndex] < 100 ? 'is-partial' : ''}}">
                              <text class="brew-record-rating-star-base">★</text>
                              <view class="brew-record-rating-star-fill" style="width: {{item.ratingStarWidths[scoreIndex]}}%;"><text>★</text></view>
                            </view>
                          </view>
                          <text wx:else class="log-wallet-unrated">未评分</text>
                          <text>查看详情 ›</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view wx:if="{{logHasMore}}" class="brew-log-load-more">继续下滑加载更多</view>
                </view>
              </block>
              <view wx:else class="brew-home-empty-log">
                <text class="brew-home-empty-title">{{logListEmptyTitle}}</text>
                <text class="brew-home-empty-copy">{{logListEmptyCopy}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'dashboard'}}" class="panel">
          <view class="brew-home">
            <view class="home-dashboard">
              <view class="main-page-header home-brand-row">
                <view class="main-page-mark main-page-mark-home"></view>
                <view class="main-page-copy home-brand-copy">
                  <text class="main-page-title home-brand-name">Pour Notes</text>
                  <text class="main-page-subtitle home-brand-subtitle"></text>
                </view>
              </view>
              <view class="home-hero-card">
                <view class="home-hero-main">
                  <text class="home-kicker">—— READY TO BREW</text>
                  <text class="home-hero-title">精准量化</text>
                  <text class="home-hero-title">每一次萃取</text>
                </view>
                <view class="home-drop-mark"></view>
                <view class="home-hero-action">
                  <text class="home-hero-copy">记录粉水比、注水、时间与风味，让每一次冲煮都有迹可循。</text>
                  <view class="home-start-button"><text>开始冲煮</text></view>
                </view>
              </view>
              <view class="home-shortcut-grid">
                <view class="home-shortcut-card">
                  <view class="home-shortcut-top"><text>冲煮记录</text><image class="home-shortcut-logo" src="../../assets/icons/home-clock.png" mode="aspectFit"></image></view>
                  <text class="home-shortcut-copy">风味轨迹</text><text class="home-shortcut-code">BREW LOGS</text>
                </view>
                <view class="home-shortcut-card">
                  <view class="home-shortcut-top"><text>总计</text><image class="home-shortcut-logo" src="../../assets/icons/home-trend.png" mode="aspectFit"></image></view>
                  <text class="home-shortcut-copy">消耗统计</text><text class="home-shortcut-code">TOTAL</text>
                </view>
                <view class="home-shortcut-card">
                  <view class="home-shortcut-top"><text>方案库</text><image class="home-shortcut-logo" src="../../assets/icons/home-book.png" mode="aspectFit"></image></view>
                  <text class="home-shortcut-copy">冲煮方案</text><text class="home-shortcut-code">RECIPES</text>
                </view>
                <view class="home-shortcut-card">
                  <view class="home-shortcut-top"><text>风味</text><image class="home-shortcut-logo" src="../../assets/icons/home-flavor.png" mode="aspectFit"></image></view>
                  <text class="home-shortcut-copy">风味记录</text><text class="home-shortcut-code">FLAVOR</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'beans'}}" class="panel">
          <view class="main-page-header catalog-page-header bean-catalog-header">
            <view class="main-page-mark main-page-mark-beans"></view>
            <view class="main-page-copy">
              <text class="main-page-title">豆仓</text>
              <text class="main-page-subtitle">在库 / 空袋</text>
            </view>
          </view>
          <view class="beans-view active bean-wallet {{beanStockMode === 'active' ? 'has-fixed-add-action' : ''}}">
            <view class="mode-switch bean-stock-switch wallet-sticky-sub">
              <view class="mode-switch-option {{beanStockMode === 'active' ? 'active' : ''}}">在库</view>
              <view class="mode-switch-option {{beanStockMode === 'empty' ? 'active' : ''}}">空袋</view>
            </view>
            <view wx:if="{{displayBeanCards.length === 0}}" class="empty-state">{{beanStockEmptyText}}</view>
            <view class="bean-wallet-stack">
              <view wx:for="{{displayBeanCards}}" wx:key="id" class="bean-swipe-row {{index === 0 ? 'is-first' : ''}} {{index === displayBeanCards.length - 1 ? 'is-last' : ''}} {{activeBeanActionId === item.id ? 'actions-open' : ''}}">
                <view class="bean-swipe-actions {{item.isEmpty ? 'is-empty' : ''}}">
                  <view class="bean-card-action edit">修改</view>
                  <view wx:if="{{!item.isEmpty}}" class="bean-card-action archive">清袋</view>
                  <view class="bean-card-action danger">移除</view>
                </view>
                <view class="card bean-card wallet-card {{beanWalletOpenId === item.id ? 'is-open' : ''}}" style="{{item.cardArtStyle}}{{beanSwipeMovingId === item.id ? beanSwipeStyle : (activeBeanActionId === item.id ? item.swipeOpenStyle : '')}}">
                  <view class="wallet-card-head">
                    <view class="wallet-card-title">
                      <text class="wallet-card-name">{{item.primaryName}}</text>
                      <text class="wallet-card-roaster">{{item.roasterText}}</text>
                    </view>
                    <view class="stock-ring wallet-card-ring" style="{{item.stockRingStyle}}">{{item.remainingWeight}}g</view>
                  </view>
                  <view wx:if="{{beanWalletOpenId === item.id}}" class="wallet-card-face">
                    <text wx:if="{{item.placeText}}" class="wallet-card-line">{{item.placeText}}</text>
                    <view wx:if="{{item.specText || item.flavorNotesText}}" class="wallet-card-group">
                      <text wx:if="{{item.specText}}" class="wallet-card-line">{{item.specText}}</text>
                      <text wx:if="{{item.flavorNotesText}}" class="wallet-card-flavor">{{item.flavorNotesText}}</text>
                    </view>
                    <view class="wallet-card-foot">
                      <text>{{item.roastDateText}}</text>
                      <text>{{item.restingText}}{{item.initialWeight ? ' · 共 ' + item.initialWeight + 'g' : ''}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'roasters'}}" class="panel">
          <view class="main-page-header catalog-page-header">
            <view class="main-page-mark main-page-mark-roasters"></view>
            <view class="main-page-copy">
              <text class="main-page-title">寻豆指南</text>
              <text class="main-page-subtitle">烘焙商 / 豆子</text>
            </view>
          </view>
          <view class="beans-view active">
            <view class="roaster-grid">
              <view wx:for="{{displayRoasters}}" wx:key="name" class="roaster-option">
                <view class="roaster-logo">
                  <image wx:if="{{item.logoImage}}" src="{{item.logoImage}}" mode="aspectFit" lazy-load="{{true}}" />
                  <text wx:else>{{item.logo}}</text>
                </view>
                <text class="roaster-name">{{item.name}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'roasterBeans'}}" class="panel">
          <view class="panel-header">
            <view class="header-back"><image class="back-button-image" src="../../assets/icons/back-arrow.png" mode="aspectFit"></image></view>
            <view class="header-title">
              <text class="eyebrow">Roaster Beans</text>
              <text class="panel-title">{{selectedRoasterName}}</text>
            </view>
          </view>
          <view class="beans-view roaster-bean-view active">
            <view class="roaster-bean-toolbar">
              <view class="roaster-bean-search" aria-role="search">
                <view class="roaster-bean-search-icon" aria-hidden="true"></view>
                <input class="roaster-bean-search-input" type="text" confirm-type="search" adjust-position="{{true}}" cursor-spacing="24" placeholder="搜索豆子" placeholder-class="roaster-bean-search-placeholder" value="{{roasterBeanSearchQuery}}" />
                <view wx:if="{{roasterBeanSearchQuery}}" class="roaster-bean-search-clear" aria-label="清空搜索">×</view>
                <view class="roaster-bean-filter-trigger {{roasterBeanActiveFilterCount > 0 ? 'is-active' : ''}} {{roasterBeanSearchFilterOpen ? 'is-open' : ''}}" aria-label="筛选豆子">
                  <text>筛选</text>
                  <text wx:if="{{roasterBeanActiveFilterCount > 0}}" class="roaster-bean-filter-count">{{roasterBeanActiveFilterCount}}</text>
                  <view class="roaster-bean-filter-trigger-arrow {{roasterBeanSearchFilterOpen ? 'is-open' : ''}}"></view>
                </view>
              </view>
              <view wx:if="{{roasterBeanSearchFilterOpen}}" class="brew-log-calendar-panel roaster-bean-filter-panel">
                <view class="roaster-bean-filter-panel-header">
                  <view class="roaster-bean-filter-heading">
                    <view class="roaster-bean-filter-heading-icon" aria-hidden="true"><view></view></view>
                    <view class="roaster-bean-filter-heading-copy">
                      <text class="roaster-bean-filter-heading-title">筛选豆子</text>
                      <text class="roaster-bean-filter-heading-caption">{{roasterBeanActiveFilterCount > 0 ? '已选 ' + roasterBeanActiveFilterCount + ' 项' : '可多选条件'}}</text>
                    </view>
                  </view>
                  <view class="roaster-bean-filter-panel-actions">
                    <view class="roaster-bean-filter-clear-all {{roasterBeanActiveFilterCount === 0 ? 'is-disabled' : ''}}">清除</view>
                    <view class="roaster-bean-filter-done">完成</view>
                  </view>
                </view>
                <view wx:for="{{roasterBeanFilterGroups}}" wx:for-item="filterGroup" wx:key="key" class="roaster-bean-filter-group">
                  <view class="roaster-bean-filter-group-heading">
                    <text class="roaster-bean-filter-group-title">{{filterGroup.label}}</text>
                    <view class="roaster-bean-filter-group-line"></view>
                  </view>
                  <view class="roaster-bean-filter-options">
                    <view wx:for="{{filterGroup.options}}" wx:for-item="filterOption" wx:key="value" class="roaster-bean-filter-option {{filterOption.isSelected ? 'is-active' : ''}}">
                      <text wx:if="{{filterOption.isSelected}}" class="roaster-bean-filter-option-check">✓</text>
                      <text>{{filterOption.value}}</text>
                    </view>
                    <text wx:if="{{filterGroup.options.length === 0}}" class="roaster-bean-filter-empty">暂无选项</text>
                  </view>
                </view>
              </view>
            </view>
            <view wx:if="{{displayRoasterBeans.length === 0}}" class="empty-state">
              <text wx:if="{{roasterBeanSearchQuery || roasterBeanActiveFilterCount > 0}}">没有找到符合条件的豆子。</text>
              <text wx:else>这个烘焙商还没有豆子。</text>
            </view>
            <view wx:else class="roaster-bean-grid">
              <view wx:for="{{displayRoasterBeans}}" wx:key="id" class="roaster-bean-option">
                <view class="roaster-bean-image-wrap">
                  <image wx:if="{{item.image}}" class="roaster-bean-image" src="{{item.image}}" mode="aspectFit" lazy-load="{{true}}" style="{{item.thumbnailStyle || ''}}" />
                  <view wx:else class="roaster-bean-image-placeholder"><view class="roaster-bean-image-loading"></view></view>
                </view>
                <text class="roaster-bean-name">{{item.name}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'roasterDetail'}}" class="panel">
          <view class="panel-header">
            <view class="header-back"><image class="back-button-image" src="../../assets/icons/back-arrow.png" mode="aspectFit"></image></view>
            <view class="header-title">
              <text class="eyebrow">Roaster Beans</text>
              <text class="panel-title"></text>
            </view>
          </view>
          <view class="beans-view active">
            <template is="roaster-bean-detail" data="{{detail: selectedRoasterBeanDetail}}"></template>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'recipes'}}" class="panel">
          <view class="panel-header recipe-panel-header">
            <view class="header-back"><image class="back-button-image" src="../../assets/icons/back-arrow.png" mode="aspectFit"></image></view>
            <view class="header-title">
              <text class="eyebrow">Recipes</text>
              <text class="panel-title">{{recipeQuickImportMode ? '选择方案' : '方案库'}}</text>
            </view>
          </view>
          <view class="recipe-view active bean-wallet {{recipeLibraryMode === 'custom' && !recipeQuickImportMode ? 'has-fixed-add-action' : ''}}">
            <view class="mode-switch recipe-library-switch wallet-sticky-sub">
              <view class="mode-switch-option {{recipeLibraryMode === 'custom' ? 'active' : ''}}">自建方案</view>
              <view class="mode-switch-option {{recipeLibraryMode === 'preset' ? 'active' : ''}}">预设方案</view>
            </view>
            <view wx:if="{{recipeQuickImportMode}}" class="recipe-quick-import-tip">
              <text>点开方案查看曲线，再点一次即可导入</text><text>导入后仍可继续修改参数</text>
            </view>
            <view wx:if="{{displayRecipes.length === 0}}" class="empty-state">{{recipeLibraryEmptyText}}</view>
            <view class="bean-wallet-stack">
              <view wx:for="{{displayRecipes}}" wx:key="id" class="bean-swipe-row {{index === 0 ? 'is-first' : ''}} {{index === displayRecipes.length - 1 ? 'is-last' : ''}} {{activeRecipeActionId === item.id ? 'actions-open' : ''}}">
                <view wx:if="{{!recipeQuickImportMode && !item.isPreset}}" class="bean-swipe-actions is-empty">
                  <view class="bean-card-action edit">修改</view>
                  <view class="bean-card-action danger">删除</view>
                </view>
                <view class="card bean-card wallet-card recipe-wallet-card {{recipeWalletOpenId === item.id ? 'is-open' : ''}} {{recipeQuickImportMode && brewRecipeSourceId === item.id ? 'is-selected' : ''}}" style="{{item.cardArtStyle}}{{recipeSwipeMovingId === item.id ? recipeSwipeStyle : (activeRecipeActionId === item.id ? 'transform:translateX(-232rpx);' : '')}}">
                  <view class="wallet-card-head">
                    <view class="wallet-card-title">
                      <text class="wallet-card-name">{{item.nameText}}</text>
                      <text class="wallet-card-roaster">{{item.walletSubtitleText}}</text>
                    </view>
                    <text wx:if="{{recipeQuickImportMode && brewRecipeSourceId === item.id}}" class="recipe-quick-selected-badge">✓ 已选择</text>
                  </view>
                  <view wx:if="{{recipeWalletOpenId === item.id}}" class="wallet-card-face recipe-wallet-face">
                    <view class="recipe-bar-preview">
                      <view class="recipe-bar-heading"><text>冲煮方案预览</text><text>累计水量(G)</text></view>
                      <view class="recipe-line-chart">
                        <view class="recipe-line-plot">
                          <view class="recipe-line-axis"></view>
                          <view wx:for="{{item.timelinePoints}}" wx:for-item="point" wx:key="id" class="recipe-line-guide" style="{{point.guideStyle}}"></view>
                          <view wx:for="{{item.timelineSegments}}" wx:for-item="segment" wx:key="id" class="recipe-line-segment" style="{{segment.style}}"></view>
                          <view wx:for="{{item.timelinePoints}}" wx:for-item="point" wx:key="id" class="recipe-line-dot" style="{{point.style}}"></view>
                          <block wx:for="{{item.timelinePoints}}" wx:for-item="point" wx:key="id">
                            <text wx:if="{{point.timeText}}" class="recipe-line-time {{point.edgeClass}}" style="{{point.timeLabelStyle}}">{{point.timeText}}</text>
                          </block>
                          <view wx:for="{{item.timelinePoints}}" wx:for-item="point" wx:key="id" class="recipe-line-water-label {{point.edgeClass}}" style="{{point.waterLabelStyle}}">{{point.waterText}}</view>
                        </view>
                      </view>
                    </view>
                    <view class="recipe-stats">
                      <view><text>水温</text><text>{{item.temperatureText}}°C</text></view>
                      <view class="recipe-stat-grind"><text>研磨</text><text>{{item.grindText}}</text></view>
                      <view><text>时间</text><text>{{item.totalTimeText}}</text></view>
                      <view><text>粉量</text><text>{{item.dose}}g</text></view>
                    </view>
                    <view class="wallet-card-foot">
                      <text>{{item.isPreset ? '预设方案' : '自建方案'}}</text>
                      <text>{{recipeQuickImportMode ? '点按导入 ›' : '查看详情 ›'}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:elif="{{edgeBackPreview.kind === 'brew'}}" class="panel">
          <view class="panel-header">
            <view class="header-back"><image class="back-button-image" src="../../assets/icons/back-arrow.png" mode="aspectFit"></image></view>
            <view class="header-title">
              <text class="eyebrow">Brew Log</text>
              <text class="panel-title">准备冲煮</text>
            </view>
          </view>

          <view class="brew-progress">
            <view wx:for="{{brewSteps}}" wx:key="key" class="brew-progress-step {{index === 1 ? 'active' : ''}}">
              <text>{{item.number}}</text>{{item.label}}
            </view>
          </view>

          <view class="section-block prepare-overview">
            <view class="prepare-choice-list prepare-wallet">
              <view wx:if="{{selectedBeanCard}}" class="prepare-bean-card" style="{{selectedBeanCard.cardArtStyle}}">
                <view class="prepare-bean-copy">
