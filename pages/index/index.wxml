                <view class="sketch-detail detail-a"></view>
                <view class="sketch-detail detail-b"></view>
                <view class="sketch-detail detail-c"></view>
                <view class="sketch-detail detail-d"></view>
                <view class="sketch-detail detail-e"></view>
                <view class="sketch-detail detail-handle"></view>
              </view>
            </view>
            <text class="dripper-name">{{item.displayName}}</text>
          </view>
          <view class="dripper-option dripper-action-option" hover-class="selected" hover-stay-time="120" bindtap="openCustomDripperForm">
            <view class="dripper-action-circle is-add">+</view>
            <text class="dripper-name">新增滤杯</text>
          </view>
          <view class="dripper-option dripper-action-option" hover-class="selected" hover-stay-time="120" bindtap="toggleDripperDeleteMode">
