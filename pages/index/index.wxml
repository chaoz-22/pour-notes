            <text class="dripper-name">{{dripperDeleteMode ? '完成删除' : '删除滤杯'}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{brewStep === 1 && !overviewBeanPickerOpen}}" class="section-block prepare-overview">
        <view class="prepare-choice-list prepare-wallet">
          <view wx:if="{{selectedBeanCard}}" class="prepare-bean-card" style="{{selectedBeanCard.cardArtStyle}}" hover-class="prepare-tile-hover" hover-stay-time="120" bindtap="openBeanPickerPage">
            <view class="prepare-bean-copy">
              <text class="prepare-tile-label">咖啡豆 · 点击更换</text>
              <text class="prepare-bean-name">{{selectedBeanCard.primaryName}}</text>
              <text class="prepare-bean-sub">{{selectedBeanCard.roasterText}}{{selectedBeanCard.restingText ? ' · ' + selectedBeanCard.restingText : ''}}</text>
            </view>
            <view class="stock-ring wallet-card-ring prepare-bean-ring" style="{{selectedBeanCard.stockRingStyle}}">{{selectedBeanCard.remainingWeight}}g</view>
          </view>
          <view wx:else class="prepare-bean-card is-empty" hover-class="prepare-tile-hover" hover-stay-time="120" bindtap="openBeanPickerPage">
            <view class="prepare-bean-copy">
              <text class="prepare-bean-name">选择咖啡豆</text>
              <text class="prepare-bean-sub">从豆仓选择一包豆子</text>
            </view>
            <view class="prepare-bean-plus">+</view>
          </view>
          <view class="prepare-tile-row">
            <view class="prepare-tile prepare-dripper-tile {{selectedDripper ? 'is-selected' : 'is-empty'}}" hover-class="prepare-tile-hover" hover-stay-time="120" bindtap="returnToDripperSelection">
              <view wx:if="{{selectedDripper}}" class="choice-dripper-icon prepare-dripper-icon">
                  <view class="dripper-icon dripper-icon-{{selectedDripperDisplay.iconType}} {{selectedDripperDisplay.image ? 'dripper-icon-image' : ''}}">
                    <image wx:if="{{selectedDripperDisplay.image}}" class="dripper-image" src="{{selectedDripperDisplay.image}}" mode="aspectFit" lazy-load="{{true}}" style="width: {{selectedDripperDisplay.imageDisplaySize}}rpx; height: {{selectedDripperDisplay.imageDisplaySize}}rpx;" data-id="{{selectedDripperDisplay.imageCacheKey}}" data-source="{{selectedDripperDisplay.imageCloudSource}}" bindload="handleRoasterGuideImageLoad"></image>
                    <text wx:elif="{{selectedDripperDisplay.initial}}" class="dripper-initial">{{selectedDripperDisplay.initial}}</text>
                    <view wx:else class="dripper-sketch">
                      <view class="sketch-top"></view>
                      <view class="sketch-body"></view>
                      <view class="sketch-base"></view>
                      <view class="sketch-detail detail-a"></view>
                      <view class="sketch-detail detail-b"></view>
                      <view class="sketch-detail detail-c"></view>
                      <view class="sketch-detail detail-d"></view>
                      <view class="sketch-detail detail-e"></view>
                      <view class="sketch-detail detail-handle"></view>
                    </view>
                  </view>
              </view>
              <view class="prepare-tile-copy">
                <text class="prepare-tile-label">滤杯</text>
                <text class="prepare-tile-value">{{selectedDripper ? (selectedDripperDisplay.displayName || selectedDripper) : '去选择 ›'}}</text>
              </view>
            </view>
            <view class="prepare-tile {{brewRecipeSourceId ? 'is-selected' : 'is-empty'}}" hover-class="prepare-tile-hover" hover-stay-time="120" bindtap="openRecipeQuickImport">
              <view class="prepare-tile-head">
                <text class="prepare-tile-label">方案（可选）</text>
                <text wx:if="{{brewRecipeSourceId}}" class="prepare-tile-clear" catchtap="clearRecipeQuickImport">×</text>
              </view>
              <text class="prepare-tile-value">{{brewRecipeSourceId ? brewRecipeSourceName : '快速导入 ›'}}</text>
            </view>
          </view>
        </view>

        <view class="parameter-orb" hover-class="parameter-orb-hover" hover-stay-time="120" bindtap="openParameterAdjust">
          <view class="orb-divider orb-divider-vertical"></view>
          <view class="orb-divider orb-divider-horizontal"></view>
          <view class="parameter-orb-cell orb-cell-coffee">
            <text class="parameter-orb-label">咖啡粉</text>
            <text class="parameter-orb-value">{{parameterSummary.coffee}}</text>
          </view>
          <view class="parameter-orb-cell orb-cell-water">
            <text class="parameter-orb-label">{{parameterSummary.waterLabel}}</text>
            <text class="parameter-orb-value">{{parameterSummary.water}}</text>
          </view>
          <view class="parameter-orb-cell orb-cell-grinder">
            <text class="parameter-orb-label">磨豆机 / 研磨度</text>
            <text class="parameter-orb-value">{{parameterSummary.grinder}}</text>
          </view>
          <view class="parameter-orb-cell orb-cell-time">
            <text class="parameter-orb-label">冲煮时间</text>
            <text class="parameter-orb-value">{{parameterSummary.brewTime}}</text>
          </view>
        </view>
        <view class="prepare-start-row">
          <view class="timer-control-button prepare-start-button" bindtap="startTimerStep">
            <image class="timer-control-image" src="../../assets/icons/timer-play.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <view wx:if="{{brewStep === 1 && overviewBeanPickerOpen}}" class="section-block bean-picker-page">
        <view class="bean-mode-panel beans-view bean-picker-existing-list active bean-wallet">
          <view wx:if="{{availableBeans.length === 0}}" class="empty-state">还没有在库豆子，请先前往豆仓添加。</view>
          <view class="bean-wallet-stack">
            <view wx:for="{{availableBeans}}" wx:key="id" id="picker-wallet-{{item.id}}" class="bean-swipe-row picker-wallet-live-row {{index === 0 ? 'is-first' : ''}} {{index === availableBeans.length - 1 ? 'is-last' : ''}}">
              <view class="card bean-card wallet-card {{pickerWalletOpenId === item.id ? 'is-open' : ''}} {{selectedBeanId === item.id ? 'is-selected' : ''}}" style="{{item.cardArtStyle}}" data-id="{{item.id}}" bindtap="tapPickerWalletCard">
                <view class="wallet-card-head">
                  <view class="wallet-card-title">
                    <text class="wallet-card-name">{{item.primaryName}}</text>
                    <text class="wallet-card-roaster">{{item.roasterText}}</text>
                  </view>
                  <view class="stock-ring wallet-card-ring" style="{{item.stockRingStyle}}">{{item.remainingWeight}}g</view>
                </view>
                <view wx:if="{{pickerWalletOpenId === item.id}}" class="wallet-card-face">
                  <text wx:if="{{item.placeText}}" class="wallet-card-line">{{item.placeText}}</text>
                  <view wx:if="{{item.specText || item.flavorNotesText}}" class="wallet-card-group">
                    <text wx:if="{{item.specText}}" class="wallet-card-line">{{item.specText}}</text>
                    <text wx:if="{{item.flavorNotesText}}" class="wallet-card-flavor">{{item.flavorNotesText}}</text>
                  </view>
                  <view class="wallet-card-foot">
                    <text>{{item.roastDateText}}</text>
                    <text>{{item.restingText}}</text>
                  </view>
                  <view class="wallet-card-tap-hint">{{selectedBeanId === item.id ? '当前使用中 · 点按继续 ›' : '点按使用这包豆子 ›'}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{brewStep === 2}}" class="section-block parameter-adjust-section">
        <view class="parameter-list param-grouped">
          <text class="param-group-title">核心参数</text>
          <view class="param-core-grid">
            <view class="param-core-tile">
              <text class="param-core-label">咖啡粉</text>
              <view class="param-stepper">
                <view class="param-step-button" hover-class="param-step-button-hover" hover-stay-time="80" data-field="dose" data-delta="-0.5" bindtap="stepBrewParam">−</view>
                <label class="param-core-value"><input id="parameter-dose" class="param-core-input" type="digit" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.dose}}" data-field="dose" bindinput="onDoseInput" /><text class="param-unit">g</text></label>
                <view class="param-step-button" hover-class="param-step-button-hover" hover-stay-time="80" data-field="dose" data-delta="0.5" bindtap="stepBrewParam">+</view>
              </view>
            </view>
            <view class="param-core-tile">
              <text class="param-core-label">水温</text>
              <view class="param-stepper">
                <view class="param-step-button" hover-class="param-step-button-hover" hover-stay-time="80" data-field="temperature" data-delta="-1" bindtap="stepBrewParam">−</view>
                <label class="param-core-value"><input id="parameter-temperature" class="param-core-input" type="digit" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.temperature}}" data-field="temperature" bindinput="onBrewInput" /><text class="param-unit">°C</text></label>
                <view class="param-step-button" hover-class="param-step-button-hover" hover-stay-time="80" data-field="temperature" data-delta="1" bindtap="stepBrewParam">+</view>
              </view>
            </view>
            <picker mode="selector" range="{{ratioLabels}}" value="{{ratioPickerIndex}}" bindchange="onRatioPickerChange">
              <view class="param-core-tile">
                <text class="param-core-label">粉水比</text>
                <view class="param-core-value param-ratio-value"><text>{{ratioDisplay}}</text><text class="param-picker-arrow">⌄</text></view>
              </view>
            </picker>
            <view class="param-core-tile">
              <text class="param-core-label">注水量 · 按粉水比自动算</text>
              <label class="param-core-value"><input id="parameter-water" class="param-core-input" type="digit" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.water}}" data-field="water" bindinput="onWaterInput" /><text class="param-unit">g</text></label>
            </view>
          </view>
          <text class="param-group-title">研磨</text>
          <view class="param-card">
            <label class="param-card-row"><text>磨豆机</text><input id="parameter-grinder" placeholder="例：C40" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.grinder}}" data-field="grinder" bindinput="onBrewInput" /></label>
            <label class="param-card-row"><text>研磨度</text><input id="parameter-grind" placeholder="例：24" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.grind}}" data-field="grind" bindinput="onBrewInput" /></label>
            <view wx:if="{{recentGrindPresets.length}}" class="param-recent-row">
              <text class="param-recent-label">最近用过</text>
              <view wx:for="{{recentGrindPresets}}" wx:key="key" class="param-recent-chip {{brewForm.grinder === item.grinder && brewForm.grind === item.grind ? 'is-active' : ''}}" hover-class="param-step-button-hover" hover-stay-time="80" data-index="{{index}}" bindtap="applyRecentGrind">{{item.label}}</view>
            </view>
          </view>
          <view class="param-card">
            <view class="param-card-row param-more-toggle {{paramMoreOpen ? 'is-open' : ''}}" hover-class="param-step-button-hover" hover-stay-time="80" bindtap="toggleParamMore">
              <text>更多参数</text>
              <text class="param-more-hint">{{paramMoreOpen ? '收起' : ((brewForm.waterQuality || brewForm.filterPaper || brewForm.sieve || brewForm.screenSize) ? '已填写' : '水质 · 滤纸 · 筛粉')}}<text class="param-more-arrow">⌄</text></text>
            </view>
            <block wx:if="{{paramMoreOpen}}">
              <label class="param-card-row"><text>水质</text><input id="parameter-water-quality" placeholder="例：农夫山泉" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.waterQuality}}" data-field="waterQuality" bindinput="onBrewInput" /></label>
              <label class="param-card-row"><text>滤纸</text><input id="parameter-filter-paper" placeholder="例：Hario 01" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.filterPaper}}" data-field="filterPaper" bindinput="onBrewInput" /></label>
              <view class="param-card-row">
                <text>筛粉</text>
                <view class="param-segment">
                  <view class="param-segment-option {{brewForm.sieve === '否' ? 'active' : ''}}" data-value="否" bindtap="setBrewSieve">否</view>
                  <view class="param-segment-option {{brewForm.sieve === '是' ? 'active' : ''}}" data-value="是" bindtap="setBrewSieve">是</view>
                </view>
              </view>
              <label wx:if="{{brewForm.sieve === '是' || brewForm.screenSize}}" class="param-card-row"><text>筛子目数</text><input id="parameter-screen-size" placeholder="例：#20" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.screenSize}}" data-field="screenSize" bindinput="onBrewInput" /></label>
            </block>
          </view>
        </view>

        <view class="steps-section-card param-steps">
          <text class="param-group-title">冲煮时间与步骤</text>
          <view class="param-time-hero">
            <view class="param-time-head">
              <label class="param-time-main">
                <text class="param-core-label">总时间 · 点击修改</text>
                <input id="parameter-total-time" class="param-time-input" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{brewForm.totalTime}}" data-field="totalTime" bindinput="onBrewInput" placeholder="2:00" />
              </label>
              <view class="param-time-summary">
                <text>{{brewForm.stages.length}} 个步骤</text>
                <text class="param-time-summary-strong">{{brewForm.water || 0}}g · {{brewForm.temperature || '-'}}°C</text>
              </view>
            </view>
            <view class="param-timeline">
              <view wx:for="{{brewForm.stages}}" wx:key="id" class="param-timeline-segment param-tone-{{index % 4}}" style="flex: {{item.duration}} 1 0;"></view>
            </view>
            <view class="param-timeline-labels">
              <text wx:for="{{brewForm.stages}}" wx:key="id" style="flex: {{item.duration}} 1 0;">{{index + 1}}</text>
            </view>
          </view>
          <view class="steps-editor param-stage-list">
            <view wx:for="{{brewForm.stages}}" wx:key="id" id="stage-editor-row-{{index}}" class="param-stage-swipe {{stageActionIndex === index ? 'actions-open' : ''}}" data-index="{{index}}" bindtouchstart="onStageTouchStart" bindtouchend="onStageTouchEnd">
              <view class="param-stage-delete" data-index="{{index}}" catchtap="deleteStageFromSwipe">删除</view>
              <view class="param-stage-card">
                <view class="param-stage-index param-tone-{{index % 4}}">{{index + 1}}</view>
                <view class="param-stage-body">
                  <textarea id="parameter-stage-name-{{index}}" class="param-stage-name" auto-height adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" bindkeyboardheightchange="onParameterKeyboardHeightChange" show-confirm-bar="{{false}}" maxlength="200" value="{{item.name}}" data-index="{{index}}" data-field="name" cursor="{{item.nameCursor}}" bindfocus="onParameterInputFocus" bindinput="onStageInput" bindblur="onStageNameBlur" />
                  <view class="param-stage-meta">
                    <text class="param-stage-range">{{item.rangeText}}</text>
                    <label class="param-stage-chip is-water"><text>至</text><input id="parameter-stage-water-{{index}}" type="digit" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{item.cumulativeWater}}" data-index="{{index}}" data-field="cumulativeWater" bindinput="onStageInput" /><text>g</text></label>
                    <label class="param-stage-chip"><input id="parameter-stage-temperature-{{index}}" type="digit" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" value="{{item.temperature}}" data-index="{{index}}" data-field="temperature" bindinput="onStageInput" /><text>°C</text></label>
                    <view class="param-stage-duration">
                      <view class="param-step-button is-small" hover-class="param-step-button-hover" hover-stay-time="80" data-index="{{index}}" data-delta="-1" bindtap="adjustStageDuration">−</view>
                      <label class="param-stage-seconds"><input id="parameter-stage-duration-{{index}}" type="number" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" cursor="{{parameterInputCursor}}" value="{{item.duration}}" data-index="{{index}}" data-field="duration" bindfocus="onParameterInputFocus" bindkeyboardheightchange="onParameterKeyboardHeightChange" bindinput="onStageInput" bindblur="onStageDurationBlur" /><text>s</text></label>
                      <view class="param-step-button is-small" hover-class="param-step-button-hover" hover-stay-time="80" data-index="{{index}}" data-delta="1" bindtap="adjustStageDuration">+</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="param-add-stage" hover-class="param-step-button-hover" hover-stay-time="80" bindtap="addStage">+ 添加步骤</view>
          <text wx:if="{{brewForm.stages.length}}" class="param-stage-tip">左滑步骤可删除</text>
        </view>
        <view class="brew-action-row parameter-save-action">
          <button class="primary-button step-next-button parameter-save-button" bindtap="saveParameterAdjustments">保存修改</button>
        </view>
        <view wx:if="{{parameterKeyboardInset > 0}}" class="parameter-keyboard-spacer" style="height: {{parameterKeyboardInset}}px;"></view>
      </view>

      <view wx:if="{{brewStep === 3}}" class="section-block">
        <view class="brew-timer-screen">
          <view class="timer-dripper-pill">
            <view class="timer-dripper-copy">
              <text>当前滤杯</text>
              <text>{{selectedDripper}}</text>
            </view>
          </view>
          <view class="timer-ring" style="background: conic-gradient(#e2bb65 {{timerStageProgress}}%, #f2e8d5 0);">
            <view class="timer-ring-core">
              <text>{{timerCountdown > 0 ? timerCountdown : timerDisplay}}</text>
            </view>
          </view>
          <view class="timer-step-copy">
            <text>{{timerStageRange}}</text>
            <text class="timer-step-name">{{timerStageName}}</text>
            <view class="timer-water-dose">
              <text>💧</text>
              <text>→ {{timerWater}}g</text>
            </view>
          </view>
          <view class="timer-controls {{timerFinished ? 'is-finished' : ''}}">
            <view class="timer-control-slot timer-control-left">
              <view wx:if="{{!timerFinished && timerCountdown === 0 && timerStageIndex > 0}}" class="timer-control-button timer-control-secondary" bindtap="skipPreviousTimerStage">
                <image class="timer-control-image" src="../../assets/icons/timer-previous.png" mode="aspectFit"></image>
              </view>
            </view>
            <view class="timer-control-slot timer-control-center">
              <view class="timer-control-button" bindtap="toggleTimer">
                <image wx:if="{{timerFinished}}" class="timer-control-image" src="../../assets/icons/timer-finished.png" mode="aspectFit"></image>
                <image wx:else class="timer-control-image" src="{{timerRunning || timerCountdown > 0 ? '../../assets/icons/timer-pause.png' : '../../assets/icons/timer-play.png'}}" mode="aspectFit"></image>
              </view>
            </view>
            <view class="timer-control-slot timer-control-right">
              <view wx:if="{{!timerFinished && timerCountdown === 0}}" class="timer-control-button timer-control-secondary" bindtap="skipTimerStage">
                <image class="timer-control-image" src="../../assets/icons/timer-next.png" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{brewStep === 4}}" class="section-block taste-section">
        <view class="result-evaluation-card">
          <view class="result-metrics">
            <label class="result-metric-field">
              <text class="result-metric-label">浓度比 TDS</text>
              <view class="result-metric-input-row">
                <input type="digit" adjust-position="{{true}}" cursor-spacing="24" placeholder="0.00" value="{{brewForm.tds}}" data-field="tds" bindinput="onBrewInput" />
                <text class="result-metric-unit">%</text>
              </view>
            </label>
            <label class="result-metric-field">
              <text class="result-metric-label">萃取率</text>
              <view class="result-metric-input-row">
                <input type="digit" adjust-position="{{true}}" cursor-spacing="24" placeholder="0.00" value="{{brewForm.extractionRate}}" data-field="extractionRate" bindinput="onBrewInput" />
                <text class="result-metric-unit">%</text>
              </view>
            </label>
          </view>
          <label class="result-review-field">
            <text class="result-review-label">结果评价</text>
            <textarea adjust-position="{{true}}" cursor-spacing="120" maxlength="200" placeholder="记录这次冲煮的整体感受…" value="{{brewForm.notes}}" data-field="notes" bindinput="onBrewInput" />
            <text class="result-review-count">{{brewForm.notes.length || 0}}/200</text>
          </label>
          <view class="flavor-rating-section">
            <view class="flavor-rating-heading">
              <text>风味评分</text>
              <text>拖动图形或输入 0–10 分</text>
            </view>
            <view class="flavor-radar-wrap">
              <view id="brew-flavor-radar-plot" class="flavor-radar-plot">
                <view wx:for="{{flavorRadarGridSegments}}" wx:for-item="segment" wx:key="key" class="flavor-radar-line flavor-radar-grid-line" style="{{segment.style}}"></view>
                <view wx:for="{{flavorRadarAxisSegments}}" wx:for-item="segment" wx:key="key" class="flavor-radar-line flavor-radar-axis-line" style="{{segment.style}}"></view>
                <view class="flavor-radar-fill" style="{{brewFlavorRadar.fillStyle}}"></view>
                <view wx:for="{{brewFlavorRadar.segments}}" wx:for-item="segment" wx:key="key" class="flavor-radar-line flavor-radar-value-line" style="{{segment.style}}"></view>
                <view wx:for="{{brewFlavorRadar.points}}" wx:for-item="point" wx:key="key" class="flavor-radar-point" style="{{point.style}}"></view>
                <view class="flavor-radar-touch-layer" data-target="brew" catchtouchstart="onFlavorRadarTouchStart" catchtouchmove="onFlavorRadarTouchMove" bindtouchend="onFlavorRadarTouchEnd" bindtouchcancel="onFlavorRadarTouchEnd"></view>
              </view>
              <label wx:for="{{flavorScoreAxes}}" wx:key="key" class="flavor-radar-axis-label flavor-radar-axis-{{item.key}}">
                <text>{{item.label}}(</text>
