                  <view wx:if="{{item.hasRecords}}" class="stats-month-picker-dot"></view>
                </view>
              </view>
            </block>
            <block wx:elif="{{statsRange === 'month' || statsRange === 'year'}}">
              <view class="stats-year-picker-grid">
                <view wx:for="{{statsCalendarYears}}" wx:key="year" class="stats-year-picker-item {{item.isSelected ? 'is-selected' : ''}} {{item.isCurrent ? 'is-current' : ''}}" data-year="{{item.year}}" bindtap="selectStatsCalendarYear">
                  <text>{{item.label}}</text>
                  <view wx:if="{{item.hasRecords}}" class="stats-year-picker-dot"></view>
                </view>
              </view>
            </block>
            <block wx:else>
              <view class="brew-log-calendar-weekdays">
                <text wx:for="{{statsCalendarWeekdays}}" wx:key="*this">{{item}}</text>
              </view>
              <view class="brew-log-calendar-days">
                <view wx:for="{{statsCalendarDays}}" wx:key="dateKey" class="brew-log-calendar-day {{item.isCurrentMonth ? '' : 'is-outside'}} {{item.isInTrendRange ? 'is-in-range' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.hasRecords ? 'has-records' : ''}}" data-date="{{item.dateKey}}" bindtap="selectStatsCalendarDate">
                  <text>{{item.day}}</text>
                  <view wx:if="{{item.hasRecords}}" class="brew-log-calendar-record-dot"></view>
                </view>
              </view>
