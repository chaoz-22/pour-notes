            <label class="parameter-row"><text>滤纸</text><input id="recipe-filter-paper" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="24" value="{{recipeForm.filterPaper}}" data-field="filterPaper" cursor="{{parameterInputCursor}}" bindfocus="onParameterInputFocus" bindblur="onParameterInputBlur" bindkeyboardheightchange="onParameterKeyboardHeightChange" bindinput="onRecipeFormInput" /></label>
