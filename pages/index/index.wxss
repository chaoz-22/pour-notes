  background: #d6ab5c;
}

.param-tone-2 {
  background: #c79633;
}

.param-tone-3 {
  background: #9d6812;
}

.param-stage-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.param-stage-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
}

.param-stage-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: grid;
  width: 140rpx;
  place-items: center;
  background: #f3d7d1;
  color: #9f3f30;
  font-size: 25rpx;
  font-weight: 800;
}

.param-stage-card {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(199, 150, 51, 0.2);
  border-radius: 26rpx;
  background: #ffffff;
  transition: transform 180ms ease;
}

.param-stage-swipe.actions-open > .param-stage-card {
  transform: translateX(-140rpx);
}

.param-stage-index {
  display: grid;
  width: 48rpx;
  height: 48rpx;
  place-items: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.param-stage-index.param-tone-0 {
  color: #412402;
}

.param-stage-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.param-stage-name {
  width: 100%;
  min-height: 0;
  color: #241b10;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.55;
}

.param-stage-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.param-stage-range {
  flex: 0 0 auto;
  color: #8a7a64;
  font-size: 22rpx;
  font-weight: 600;
}

.param-stage-chip {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 2rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f7f0e2;
  color: #5b4f40;
  font-size: 22rpx;
  font-weight: 650;
}

.param-stage-chip.is-water {
  background: #fbf3df;
  color: #633806;
}

.param-stage-chip input {
  width: 2.4em;
  min-height: 0;
  height: 1.4em;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.param-stage-duration {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 6rpx;
}

.param-stage-seconds {
  display: flex;
  align-items: baseline;
  color: #241b10;
  font-size: 26rpx;
  font-weight: 800;
}

.param-stage-seconds input {
  width: 2em;
  min-height: 0;
  height: 1.3em;
  font-size: 26rpx;
  font-weight: 800;
  text-align: right;
}

.param-add-stage {
  padding: 20rpx 0;
  border: 2rpx dashed rgba(199, 150, 51, 0.6);
  border-radius: 999rpx;
  color: #9d6812;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.param-stage-tip {
  display: block;
  color: #b9ad98;
  font-size: 21rpx;
  text-align: center;
}

.param-core-grid > picker {
  display: block;
  min-width: 0;
}

/* The open card itself is the action (like the recipe library), so a quiet hint
   replaces the black button. */
.wallet-card-tap-hint {
  margin-top: -18rpx;
  color: #b88222;
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

/* Brew detail pour section: same time bar and step cards as the parameter page. */
.pour-summary {
  margin-top: 8rpx;
}

.pour-total-time {
  color: #241b10;
  font-size: 60rpx;
  font-weight: 850;
  line-height: 1.2;
}

.pour-step-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 26rpx;
}

.param-stage-card.pour-step-card {
  border-color: rgba(199, 150, 51, 0.16);
  background: #fffdf9;
}

.pour-step-text {
  display: block;
  color: #241b10;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.55;
}

.pour-step-seconds {
  flex: 0 0 auto;
  min-width: 64rpx;
  color: #241b10;
  font-size: 26rpx;
  font-weight: 800;
  text-align: right;
}

/* The floating tab bar is ~180rpx tall from the bottom edge; leave clear room so
   the rating at the end of the brew detail isn't hidden behind it. */
.brew-detail-active .content {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* Recipe detail mirrors the brew detail layout. */
.recipe-detail-card .recipe-detail-keys {
  margin-top: 8rpx;
}

.recipe-detail-card .recipe-detail-list {
  margin-top: 16rpx;
}

.recipe-detail-card .recipe-detail-pour-title {
  margin-top: 32rpx;
}

.recipe-view.active > .recipe-detail-card {
  margin-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* Keep detail pages inside the screen: long values truncate in the list and wrap
   in "更多参数" instead of widening the card. */
.recipe-view.active {
  grid-template-columns: minmax(0, 1fr);
}

.recipe-detail-card,
.log-detail-list,
.log-detail-key-grid {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
}

.log-detail-list-row > text:last-child {
  flex: 1 1 auto;
  min-width: 0;
}

.log-detail-list-row.is-more {
  align-items: flex-start;
  padding: 24rpx 0;
}

.log-detail-list-row.is-more > text:last-child {
  line-height: 1.45;
  white-space: normal;
  word-break: break-all;
}

/* Pour bar: one column per step with the cumulative water above, the step number
   in the segment, and the start time below (end time under the last one) — the
   same information as the old curve chart, without overlapping labels. */
.pour-bar {
  display: flex;
  gap: 4rpx;
  margin-top: 22rpx;
}

.pour-bar-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 76rpx;
}

.pour-bar-water {
  display: block;
  overflow: hidden;
  color: #241b10;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
  white-space: nowrap;
}

.pour-bar-seg {
  display: flex;
  align-items: center;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
}

.pour-bar-col:first-child .pour-bar-seg {
  border-radius: 999rpx 8rpx 8rpx 999rpx;
}

.pour-bar-col:last-child .pour-bar-seg {
  border-radius: 8rpx 999rpx 999rpx 8rpx;
}

.pour-bar-col:only-child .pour-bar-seg {
  border-radius: 999rpx;
}

.pour-bar-seg > text {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.pour-bar-seg.param-tone-0 > text {
  color: #412402;
}

.pour-bar-times {
  display: flex;
  justify-content: space-between;
  color: #8a7a64;
  font-size: 20rpx;
  font-weight: 650;
  white-space: nowrap;
}

/* A step whose temperature differs from the brew's main temperature stands out. */
.param-stage-chip.is-temp-diff {
  background: #fbe3d6;
  color: #993c1d;
}

/* Clearer edge where each stacked card sits on the one before it. */
.bean-wallet-stack > .bean-swipe-row > .bean-card.wallet-card {
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-top: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 -12rpx 28rpx rgba(70, 50, 24, 0.16),
    0 -1rpx 0 rgba(70, 50, 24, 0.08),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
}

/* Recipe editor uses the same grouped cards as the brew parameter page. */
.recipe-form {
  min-width: 0;
}


.recipe-form textarea.param-stage-name,
.recipe-form textarea.bean-form-flavor-input {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

/* The recipe notes field matches the bean flavour field exactly: one line tall,
   left-aligned, vertically centred, and growing downward as text is added. */
.recipe-form textarea.bean-form-flavor-input {
  width: 100%;
  min-height: 0;
  color: #1f1a14;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: left;
}

.recipe-form textarea.param-stage-name {
  min-height: 0;
  font-size: 27rpx;
  font-weight: 650;
}

/* Add / edit bean: grouped cards like the brew and recipe editors. */
.bean-form-grouped .bean-ocr-card {
  margin-bottom: 4rpx;
}

.bean-form-roast-value {
  color: #241b10;
  font-size: 27rpx;
  font-weight: 700;
}

.bean-form-roast-value.is-empty {
  color: #b9ad98;
  font-weight: 500;
}

.bean-form-core-value {
  justify-content: flex-start;
}

.param-core-input.bean-form-date-input {
  width: 100%;
  font-size: 36rpx;
  text-align: left;
}

.bean-form-grouped .param-core-input {
  text-align: left;
}

.bean-form-grouped .bean-form-save-button {
  width: 100%;
  min-height: 96rpx;
  margin: 24rpx 0 0;
  border-radius: 24rpx;
  background: #c79633;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 96rpx;
  box-shadow: 0 18rpx 42rpx rgba(151, 111, 38, 0.22);
}

.mine-record-summary {
  width: 100%;
  text-align: center;
}

/* Card actions live on a link at the card's foot; tapping elsewhere on the card
   only opens or collapses it. */
.wallet-card-tap-hint {
  display: flex;
  justify-content: flex-end;
}

.wallet-card-link {
  display: inline-block;
  margin: -12rpx -12rpx -12rpx 0;
  padding: 12rpx;
  border-radius: 999rpx;
  color: #b88222;
  font-size: 24rpx;
  font-weight: 750;
}

.wallet-card-link-hover {
  background: rgba(199, 150, 51, 0.14);
}

/* 在库 / 空袋 and 自建 / 预设: a light segmented control — the selected side is a
   raised white chip instead of a heavy black block — with counts beside each label. */
.mode-switch.bean-stock-switch,
.mode-switch.recipe-library-switch {
  gap: 6rpx;
  padding: 6rpx;
  border: 0;
  border-radius: 24rpx;
  background: #f3ece0;
}

.mode-switch.bean-stock-switch .mode-switch-option,
.mode-switch.recipe-library-switch .mode-switch-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 70rpx;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  background: transparent;
  color: #8a7a64;
  font-size: 26rpx;
  font-weight: 650;
}

.mode-switch.bean-stock-switch .mode-switch-option.active,
.mode-switch.recipe-library-switch .mode-switch-option.active {
  border-color: #e6dac4;
  background: #ffffff;
  color: #241b10;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(80, 58, 28, 0.1);
}

.mode-switch.bean-stock-switch .mode-switch-option-hover,
.mode-switch.recipe-library-switch .mode-switch-option-hover {
  background: rgba(255, 255, 255, 0.6);
}

.mode-switch-count {
  color: #a39782;
  font-size: 23rpx;
  font-weight: 700;
}

.mode-switch-option.active .mode-switch-count {
  color: #b88222;
}

/* Brew prep rows: long bean / dripper / recipe names end in "…" instead of
   wrapping or widening the row. */
.prepare-choice-list,
.prepare-choice-row,
.prepare-choice-row .choice-copy {
  min-width: 0;
}

.prepare-choice-row .choice-title,
.prepare-choice-row .choice-subtitle,
.prepare-choice-row .recipe-quick-selected-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Brew prep: a little more space between the three rows, and the rows plus the
   parameter panel sit a bit lower on the page. */
.fixed-brew-screen .prepare-choice-list {
  gap: 30rpx;
  margin-top: 28rpx;
}

/* The whole foot row of an open card is the tap target (not just the small link). */
.wallet-card-action-row {
  margin: 0 -16rpx -16rpx;
  padding: 18rpx 16rpx 16rpx;
  border-radius: 0 0 24rpx 24rpx;
}

.wallet-card-foot.wallet-card-action-row {
  margin-top: 0;
}

.wallet-card-tap-hint.wallet-card-action-row {
  margin-top: -18rpx;
}

.wallet-card-foot-hover {
  background: rgba(199, 150, 51, 0.12);
}

.wallet-card-action-row .wallet-card-link {
  margin: 0;
  padding: 0;
}

/* Bean filter: simple header, a selected count per group, options on an even
   grid, folding for long groups, and a "查看 N 款豆子" footer. */
.roaster-bean-filter-panel.bean-filter-v2 {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 26rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.bean-filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bean-filter-title {
  color: #241b10;
  font-size: 30rpx;
  font-weight: 800;
}

.bean-filter-clear {
  color: #b88222;
  font-size: 24rpx;
  font-weight: 700;
}

.bean-filter-clear.is-disabled {
  color: #cfc4b2;
}

.bean-filter-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.bean-filter-group-title {
  color: #6e5b43;
  font-size: 25rpx;
  font-weight: 750;
}

.bean-filter-group-state {
  color: #a39782;
  font-size: 22rpx;
  font-weight: 650;
}

.bean-filter-group-state.is-active {
  color: #b88222;
}

.bean-filter-grid {
  display: grid;
  gap: 12rpx;
}

.bean-filter-grid.cols-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.bean-filter-grid.cols-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.bean-filter-option {
  overflow: hidden;
  padding: 16rpx 6rpx;
  border-radius: 18rpx;
  background: #f7f0e2;
  color: #4b4135;
  font-size: 23rpx;
  font-weight: 650;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bean-filter-option.is-wide {
  grid-column: span 2;
}

.bean-filter-option.is-active {
  background: #241b10;
  color: #fffdf8;
}

.bean-filter-option-hover {
  opacity: 0.75;
}

.bean-filter-more {
  margin-top: 14rpx;
  color: #b88222;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.bean-filter-empty {
  color: #a39782;
  font-size: 22rpx;
}

.bean-filter-done {
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: #c79633;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
}

.bean-filter-done-hover {
  opacity: 0.85;
}

.roaster-bean-filter-trigger.is-active {
  background: #241b10;
  color: #fffdf8;
}

/* Roaster bean list: one horizontal card per bean — thumbnail, name, "产地 · 品种 ·
   处理法" and two flavour tags — so beans can be compared before opening them. */
.roaster-bean-grid.roaster-bean-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.roaster-bean-list .roaster-bean-option {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(199, 150, 51, 0.18);
  border-radius: 26rpx;
  background: #ffffff;
}

.roaster-bean-list .roaster-bean-image-wrap {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 132rpx;
  padding-bottom: 0;
  border-radius: 18rpx;
  box-shadow: none;
}

.roaster-bean-copy {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.roaster-bean-list .roaster-bean-name {
  min-height: 0;
  padding: 0;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roaster-bean-meta {
  display: block;
  color: #8a7a64;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
}

/* All flavour notes as one quiet line in the card's own palette, wrapping when long. */
.roaster-bean-flavor {
  display: block;
  color: #9a7a4c;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.5;
}

/* Long bean names wrap inside the card instead of widening the list off screen. */
.beans-view.roaster-bean-view {
  grid-template-columns: minmax(0, 1fr);
}

.roaster-bean-grid.roaster-bean-list,
.roaster-bean-list .roaster-bean-option {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.roaster-bean-list .roaster-bean-name {
  overflow: visible;
  line-height: 1.35;
  white-space: normal;
  word-break: break-word;
}

/* Add / edit bean and recipe editor: a compact flavour / notes field with its text
   left-aligned and vertically centred in the box, and darker text overall so the
   forms are easier to read. */
.bean-form-flavor-card {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 18rpx 26rpx;
}

.bean-form-flavor-input {
  width: 100%;
  min-height: 0;
  color: #1f1a14;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: left;
}

.bean-form-grouped .param-group-title,
.recipe-form-grouped .param-group-title {
  color: #5b4f40;
}

.bean-form-grouped .param-card-row > text:first-child,
.bean-form-grouped .param-core-label,
.recipe-form-grouped .param-card-row > text:first-child,
.recipe-form-grouped .param-core-label {
  color: #3b332a;
}

.bean-form-grouped .param-card-row input,
.bean-form-grouped .param-core-input,
.bean-form-grouped .bean-form-roast-value,
.recipe-form-grouped .param-card-row input,
.recipe-form-grouped .param-core-input {
  color: #1f1a14;
}

.bean-form-placeholder,
.bean-form-grouped .bean-form-roast-value.is-empty {
  color: #9a8c78;
  font-weight: 500;
}

/* Result step: brew name on top. Spacing stays as before; only the notes box and
   the radar area are a little shorter so the step still fits on one screen. */
.taste-section .result-name-field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 18rpx;
  padding: 20rpx 6rpx 16rpx;
  border-bottom: 1rpx solid rgba(197, 151, 62, 0.2);
}

.taste-section .result-name-label {
  flex: 0 0 auto;
  color: #554b3e;
  font-size: 25rpx;
  font-weight: 800;
}

.taste-section .result-name-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 60rpx;
  color: #1f1a14;
  font-size: 29rpx;
  font-weight: 800;
  text-align: right;
}

.taste-section .result-review-field textarea {
  height: 120rpx;
}

.taste-section .flavor-radar-wrap {
  height: 400rpx;
}
