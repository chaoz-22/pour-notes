@import "../../templates/roaster-bean-detail.wxss";
@import "./flavor-page.wxss";

.edge-back-stage {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
  background: #fffdf8;
}

.edge-back-system-gesture-guard {
  position: fixed;
  z-index: 1000;
  top: 0;
  bottom: 0;
  left: 0;
  width: 72rpx;
  overflow: hidden;
  clip-path: polygon(
    0 0,
    32rpx 0,
    32rpx calc(var(--status-bar-height) + var(--navigation-bar-height)),
    72rpx calc(var(--status-bar-height) + var(--navigation-bar-height)),
    72rpx 100%,
    0 100%
  );
  touch-action: none;
  overscroll-behavior: none;
  background: transparent;
}

.app-shell.edge-back-current {
  position: fixed;
  inset: 0;
  z-index: 3;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  box-shadow: -18rpx 0 52rpx rgba(37, 26, 13, 0.2);
  will-change: transform;
}

.edge-back-previous {
  position: fixed;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fffdf8;
  will-change: transform;
}

.edge-back-real-app {
  width: 100%;
  height: 100%;
  min-height: 100%;
  pointer-events: none;
}

.edge-back-real-app .edge-back-real-shade {
  z-index: 100;
}

.edge-back-preview-screen {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 0 32rpx calc(138rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 84% 8%, rgba(229, 190, 109, 0.12), transparent 34%),
    #fffdf8;
}

.edge-back-preview-header {
  position: relative;
  display: flex;
  min-height: 144rpx;
  align-items: center;
  justify-content: center;
  margin: 0 -32rpx 32rpx;
  padding: calc(28rpx + env(safe-area-inset-top)) 96rpx 22rpx;
  border-bottom: 1rpx solid rgba(197, 151, 62, 0.36);
  background: rgba(255, 255, 255, 0.9);
}

.edge-back-preview-back {
  position: absolute;
  left: 32rpx;
  bottom: 24rpx;
  display: grid;
  width: 64rpx;
  height: 64rpx;
  place-items: center;
  border: 1rpx solid rgba(197, 151, 62, 0.38);
  border-radius: 50%;
  background: #ffffff;
  color: #8a6425;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
}

.edge-back-preview-heading {
  display: grid;
  justify-items: center;
}

.edge-back-preview-title {
  color: #241b10;
  font-size: 40rpx;
  font-weight: 900;
}

.edge-back-preview-subtitle {
  margin-top: 4rpx;
  color: #9c8d77;
  font-size: 20rpx;
  font-weight: 650;
}

.edge-back-list-preview {
  display: grid;
  gap: 20rpx;
}

.edge-back-preview-segmented {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f3ede2;
  color: #877966;
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
}

.edge-back-preview-segmented view {
  padding: 18rpx;
  border-radius: 999rpx;
}

.edge-back-preview-segmented .is-active {
  background: #241b10;
  color: #ffffff;
}

.edge-back-preview-card {
  display: flex;
  min-height: 126rpx;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.4);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(109, 77, 24, 0.06);
}

.edge-back-preview-badge {
  display: grid;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  place-items: center;
  overflow: hidden;
  border-radius: 50%;
  background: #f2dfb8;
  color: #5a401b;
  font-size: 20rpx;
  font-weight: 900;
}

.edge-back-preview-card-copy {
  display: grid;
  min-width: 0;
  flex: 1;
  gap: 8rpx;
}

.edge-back-preview-card-title,
.edge-back-preview-card-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edge-back-preview-card-title {
  color: #241b10;
  font-size: 30rpx;
  font-weight: 850;
}

.edge-back-preview-card-meta {
  color: #8d806e;
  font-size: 22rpx;
  font-weight: 600;
}

.edge-back-preview-card-trailing {
  flex: 0 0 auto;
  color: #b88222;
  font-size: 21rpx;
  font-weight: 800;
}

.edge-back-preview-empty {
  padding: 96rpx 0;
  color: #a69a88;
  font-size: 26rpx;
  text-align: center;
}

.edge-back-dashboard-preview {
  display: grid;
  gap: 28rpx;
}

.edge-back-dashboard-hero {
  display: grid;
  min-height: 430rpx;
  align-content: center;
  padding: 44rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 82% 22%, rgba(218, 167, 63, 0.62), transparent 28%),
    linear-gradient(145deg, #2b2013, #4e3820);
  color: #ffffff;
  box-shadow: 0 24rpx 54rpx rgba(74, 49, 18, 0.18);
}

.edge-back-dashboard-kicker {
  margin-bottom: 22rpx;
  color: #e1b95d;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.edge-back-dashboard-title {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.2;
}

.edge-back-dashboard-button {
  width: 210rpx;
  margin-top: 42rpx;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  background: #cf982e;
  font-size: 25rpx;
  font-weight: 850;
  text-align: center;
}

.edge-back-dashboard-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.edge-back-dashboard-grid view {
  min-height: 142rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.34);
  border-radius: 28rpx;
  background: #ffffff;
  color: #2c2114;
  font-size: 27rpx;
  font-weight: 850;
}

.edge-back-mine-preview {
  display: grid;
  justify-items: center;
  gap: 18rpx;
}

.edge-back-profile-avatar {
  width: 144rpx;
  height: 144rpx;
  overflow: hidden;
  border: 8rpx solid #f2dfb8;
  border-radius: 50%;
  background: #ffffff;
}

.edge-back-profile-avatar image {
  width: 100%;
  height: 100%;
}

.edge-back-profile-name {
  margin-bottom: 30rpx;
  color: #241b10;
  font-size: 34rpx;
  font-weight: 900;
}

.edge-back-profile-row {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.34);
  border-radius: 24rpx;
  background: #ffffff;
  color: #302316;
  font-size: 27rpx;
  font-weight: 750;
}

.edge-back-profile-row text {
  color: #ad9f8b;
  font-size: 38rpx;
}

.edge-back-flavor-preview {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.edge-back-flavor-card {
  display: grid;
  min-height: 174rpx;
  align-content: end;
  gap: 6rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #f2dfb8;
  color: #322416;
}

.edge-back-flavor-card text:first-child {
  font-size: 28rpx;
  font-weight: 900;
}

.edge-back-flavor-card text:last-child {
  font-size: 20rpx;
  font-weight: 650;
  opacity: 0.72;
}

.edge-back-brew-preview {
  display: grid;
  justify-items: center;
}

.edge-back-brew-orb {
  display: grid;
  width: 220rpx;
  height: 220rpx;
  margin: 40rpx 0 26rpx;
  place-items: center;
  border-radius: 50%;
  background: #f2dfb8;
  font-size: 74rpx;
}

.edge-back-brew-title {
  margin-bottom: 42rpx;
  color: #241b10;
  font-size: 38rpx;
  font-weight: 900;
}

.edge-back-brew-row {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eadfcf;
  color: #36291b;
  font-size: 27rpx;
  font-weight: 750;
}

.edge-back-brew-row text {
  color: #a37a34;
}

.edge-back-preview-tabs {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 74rpx;
  padding: 20rpx 28rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.35);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 26rpx 70rpx rgba(91, 62, 23, 0.14);
}

.edge-back-preview-tabs image {
  width: 56rpx;
  height: 56rpx;
}

.edge-back-preview-shade {
  position: absolute;
  inset: 0;
  z-index: 10;
  pointer-events: none;
  background: #000000;
  will-change: opacity;
}

.app-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #241b10;
}

page,
view,
text,
button,
input,
textarea,
scroll-view,
picker {
  box-sizing: border-box;
}

.content {
  height: 100vh;
  padding: 0 32rpx calc(138rpx + env(safe-area-inset-bottom));
}

.timer-active .content {
  padding-bottom: 0;
}

.fixed-brew-screen {
  height: 100vh;
}

.fixed-brew-screen .content {
  height: 100vh;
  overflow: hidden;
  padding-bottom: calc(116rpx + env(safe-area-inset-bottom));
}

.fixed-brew-screen .panel {
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.tabs {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 100rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.42);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 36rpx 88rpx rgba(151, 111, 38, 0.2);
}

.tab {
  margin: 0;
  padding: 0 6rpx;
  display: grid;
  place-items: center;
  min-height: 94rpx;
  border-radius: 999rpx;
  color: #241b10;
  font-size: 27rpx;
  font-weight: 850;
  line-height: normal;
}

.tab text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
}

.tab.active {
  background: #f7f0e2;
  color: #c79633;
}

.flavor-detail-active .tabs {
  visibility: hidden;
  pointer-events: none;
}

.panel {
  min-height: 100vh;
}

.panel-header {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 144rpx;
  margin: 0 -32rpx 36rpx;
  padding: calc(28rpx + env(safe-area-inset-top)) 96rpx 22rpx;
  border-bottom: 1rpx solid rgba(197, 151, 62, 0.42);
  background: rgba(255, 255, 255, 0.86);
}

.header-title {
  display: grid;
  justify-items: center;
}

.eyebrow {
  display: none;
}

.panel-title {
  color: #241b10;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 0;
  text-align: center;
}

.roaster-detail-header {
  min-height: 116rpx;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
}

.roaster-detail-header .panel-title {
  font-size: 30rpx;
  font-weight: 650;
}

.header-back,
.ghost-button,
.header-icon-button {
  position: absolute;
  top: calc(28rpx + env(safe-area-inset-top));
  display: grid;
  width: 64rpx;
  height: 64rpx;
  min-width: 0;
  place-items: center;
  padding: 0;
  border: 1rpx solid rgba(197, 151, 62, 0.42);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  color: #241b10;
  box-shadow: 0 14rpx 32rpx rgba(151, 111, 38, 0.14);
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1;
}

.header-back {
  left: 32rpx;
  overflow: hidden;
  padding: 0;
}

.back-button-image {
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 60rpx;
  height: 60rpx;
  transform: translate(-50%, -50%);
}

.ghost-button {
  right: 32rpx;
  width: 76rpx;
  color: #7e715f;
  font-size: 25rpx;
}

.header-actions {
  position: absolute;
  top: calc(28rpx + env(safe-area-inset-top));
  right: 32rpx;
}

.header-icon-button {
  position: static;
  color: #c79633;
  font-size: 22rpx;
  padding-bottom: 4rpx;
}

.danger {
  color: #9f3f30;
}

.brew-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 40rpx;
  margin-bottom: 28rpx;
}

.brew-progress-step {
  min-height: 94rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #7e715f;
  font-size: 22rpx;
  font-weight: 850;
  box-shadow: 0 16rpx 40rpx rgba(151, 111, 38, 0.08);
}

.brew-progress-step text {
  display: block;
  margin-bottom: 8rpx;
  color: rgba(126, 113, 95, 0.72);
  font-size: 18rpx;
}

.brew-progress-step.active {
  background: #241b10;
  color: #ffffff;
}

.brew-progress-step.active text {
  color: rgba(255, 255, 255, 0.7);
}

.section-block,
.bean-mode-panel,
.beans-view,
.recipe-view,
.recipe-form,
.form-grid,
.parameter-list,
.steps-editor {
  position: relative;
  display: grid;
  gap: 20rpx;
}

.mode-switch {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.42);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
}

.mode-switch-option {
  display: grid;
  place-items: center;
  margin: 0;
  padding: 0 12rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  color: #7e715f;
  font-size: 26rpx;
  font-weight: 850;
  line-height: normal;
  text-align: center;
}

.mode-switch-option.active {
  background: #241b10;
  color: #ffffff;
}

.mode-switch-option-hover {
  background: rgba(36, 27, 16, 0.12);
  color: #241b10;
}

.mode-switch-option.active.mode-switch-option-hover,
.mode-switch-option.active {
  background: #241b10;
  color: #ffffff;
}

.card,
.empty-state,
.parameter-row,
.stage-row,
.timer-dripper-pill {
  border: 1rpx solid rgba(197, 151, 62, 0.24);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 44rpx rgba(151, 111, 38, 0.12);
}

.empty-state {
  padding: 34rpx;
  color: #7e715f;
  font-size: 27rpx;
  line-height: 1.55;
}

.bean-card {
  position: relative;
  width: 100%;
  padding: 26rpx;
  text-align: left;
}

.bean-card.selected {
  border-color: #c79633;
  background: #fff8e8;
}

.bean-summary {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.stock-ring {
  display: grid;
  flex: 0 0 auto;
  width: 116rpx;
  height: 116rpx;
  place-items: center;
  border: 8rpx solid #e2bb65;
  border-radius: 50%;
  background: #fffdf8;
  color: #241b10;
  font-size: 25rpx;
  font-weight: 900;
}

.bean-summary-text {
  min-width: 0;
}

.bean-date-line {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #7e715f;
  font-size: 22rpx;
  font-weight: 750;
}

.bean-name-line {
  display: block;
  margin-top: 10rpx;
  color: #241b10;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.28;
}

.bean-roaster {
  display: block;
  margin-top: 8rpx;
  color: #7e715f;
  font-size: 24rpx;
  font-weight: 750;
}

.bean-swipe-row {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
}

.bean-swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: grid;
  width: 348rpx;
  grid-template-columns: repeat(3, 108rpx);
  gap: 8rpx;
  align-items: stretch;
  padding-left: 12rpx;
}

.bean-swipe-actions.is-empty {
  width: 232rpx;
  grid-template-columns: repeat(2, 108rpx);
}

.bean-swipe-actions .bean-card-action {
  height: 100%;
  min-height: 0;
  border-radius: 0;
}

.bean-swipe-actions .bean-card-action.danger {
  border-radius: 0 28rpx 28rpx 0;
}

.bean-swipe-row > .bean-card {
  position: relative;
  z-index: 2;
  transition: transform 180ms ease;
  will-change: transform;
}

.bean-swipe-row.actions-open > .bean-card {
  transform: translateX(-348rpx);
}

.recipe-swipe-row > .recipe-card {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 100%;
  transition: transform 180ms ease;
  will-change: transform;
}

.recipe-swipe-row.actions-open > .recipe-card {
  transform: translateX(-232rpx);
}

.recipe-add-button {
  color: #241b10;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1;
}

.bean-card-action {
  display: grid;
  min-height: 58rpx;
  place-items: center;
  border-radius: 18rpx;
  background: #f7f0e2;
  color: #241b10;
  font-size: 23rpx;
  font-weight: 850;
}

.bean-card-action.edit {
  background: #ead3ac;
}

.bean-card-action.archive {
  background: #e8dcc9;
  color: #6e5b43;
}

.bean-card-action.danger {
  background: #f3d7d1;
  color: #9f3f30;
}

.bean-card-detail {
  display: grid;
  gap: 24rpx;
}

.dripper-delete-button,
.stage-delete-button {
  position: absolute;
  z-index: 5;
  display: grid;
  width: 42rpx;
  height: 42rpx;
  min-width: 0;
  place-items: center;
  padding: 0;
  border-radius: 50%;
  background: #9f3f30;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.bean-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.bean-detail-grid view {
  display: grid;
  gap: 8rpx;
  min-height: 104rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fbf7ee;
  color: #241b10;
  font-size: 24rpx;
  font-weight: 800;
}

.bean-detail-grid view text:first-child {
  color: #7e715f;
  font-size: 20rpx;
  font-weight: 750;
}

.bean-detail-grid > .bean-detail-brew-row {
  grid-column: 1 / -1;
  display: block;
  min-height: 0;
  padding: 20rpx 0 0;
  border-top: 1rpx solid rgba(197, 151, 62, 0.16);
  border-radius: 0;
  background: transparent;
}

.bean-detail-grid .bean-detail-brew-button {
  width: 100%;
  min-height: 76rpx;
  margin: 0;
  font-size: 25rpx;
}

.form-grid input,
.recipe-form textarea {
  min-height: 92rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(197, 151, 62, 0.24);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #241b10;
  font-size: 28rpx;
  font-weight: 750;
}

.primary-button,
.secondary-button,
.ghost-button,
.step-next-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

button.primary-button::after,
button.secondary-button::after,
button.ghost-button::after {
  border: 0;
}

.primary-button {
  background: #241b10;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid rgba(197, 151, 62, 0.42);
  background: #f7f0e2;
  color: #241b10;
}

.custom-dripper-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: calc(82rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 20;
  display: grid;
  place-items: center;
