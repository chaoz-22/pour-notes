}

/* Stats: one summary line, three KPIs, a single-colour trend and one ranked breakdown. */
.stats-clean .stats-summary-line {
  display: block;
  padding: 4rpx 6rpx 0;
  color: #4b4135;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.55;
}

.stats-clean .stats-kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stats-clean .stats-kpi {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  padding: 20rpx 20rpx 18rpx;
  border: 1rpx solid rgba(199, 150, 51, 0.18);
  border-radius: 24rpx;
  background: #ffffff;
}

.stats-clean .stats-kpi-label {
  color: #8a7a64;
  font-size: 22rpx;
  font-weight: 650;
}

.stats-clean .stats-kpi-value {
  overflow: hidden;
  color: #241b10;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-clean .stats-kpi-sub {
  overflow: hidden;
  color: #a39782;
  font-size: 20rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-clean .stats-kpi-sub.is-up {
  color: #3b6d11;
}

.stats-clean .stats-kpi-sub.is-down {
