}

.trend-bar-value {
  min-height: 26rpx;
  color: #7e715f;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
}

.trend-bar-track {
  display: flex;
  width: 100%;
  height: 160rpx;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 1rpx solid rgba(169, 137, 88, 0.18);
  background-image: repeating-linear-gradient(
    to top,
    rgba(169, 137, 88, 0.1) 0,
    rgba(169, 137, 88, 0.1) 1rpx,
    transparent 1rpx,
    transparent 40rpx
  );
}

.trend-bar-fill {
  width: 28rpx;
  min-height: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #d6a852 0%, #9f6d20 100%);
  box-shadow: 0 5rpx 12rpx rgba(111, 77, 27, 0.15);
  transition: width 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.trend-bar-label,
.trend-bar-sub-label {
  display: block;
  max-width: 100%;
  color: #7e715f;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}

.trend-bar-label {
  height: 24rpx;
  min-height: 24rpx;
  line-height: 24rpx;
}

.trend-bar-sub-label {
  min-height: 22rpx;
  color: #b2a58f;
  font-size: 18rpx;
  font-weight: 600;
}

.roaster-bean-view {
