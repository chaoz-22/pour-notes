  font-size: 23rpx;
  font-weight: 650;
}

.stats-clean .stats-rank-tab.active {
  background: #fbf3df;
  color: #9d6812;
}

.stats-clean .stats-rank-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.stats-clean .stats-rank-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.stats-clean .stats-rank-name {
  overflow: hidden;
  color: #241b10;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-clean .stats-rank-value {
  flex: 0 0 auto;
  color: #8a7a64;
  font-size: 23rpx;
  font-weight: 600;
}

.stats-clean .stats-rank-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #f5efe4;
}

.stats-clean .stats-rank-fill {
  height: 12rpx;
  border-radius: 999rpx;
}

/* Recipe library uses the same wallet stack; the open card shows its pour curve. */
