}

.stats-clean .trend-bar-item.is-empty .trend-bar-fill {
  width: 20rpx;
  min-height: 6rpx;
  background: rgba(169, 137, 88, 0.18);
}

.stats-clean .trend-bar-item.is-active {
  background: transparent;
  box-shadow: none;
}

.stats-clean .trend-bar-item.is-active .trend-bar-fill {
  width: 30rpx;
  background: #9d6812;
  box-shadow: none;
}

.stats-clean .trend-bar-item .trend-bar-value {
  color: transparent;
}

.stats-clean .trend-bar-item.is-active .trend-bar-value {
  color: #9d6812;
}

.stats-clean .trend-bar-item.is-active .trend-bar-label,
.stats-clean .trend-bar-item.is-active .trend-bar-sub-label {
  color: #241b10;
}

.stats-clean .stats-rank-period {
  color: #a39782;
  font-size: 21rpx;
