  font-weight: 750;
  line-height: normal;
}

.stats-range-option.active {
  background: #241b10;
  color: #ffffff;
}

.stats-total-card {
  display: flex;
  min-height: 176rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #241b10;
  box-shadow: 0 18rpx 44rpx rgba(36, 27, 16, 0.16);
}

.stats-total-label,
.stats-period-text {
  display: block;
}

.stats-total-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  font-weight: 800;
}

.stats-period-text {
