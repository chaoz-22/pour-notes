  row-gap: 42rpx;
  width: 100%;
}

.roaster-bean-option {
  display: grid;
  min-width: 0;
  align-content: start;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.roaster-bean-image-wrap {
  position: relative;
