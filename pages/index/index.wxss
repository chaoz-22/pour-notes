}

/* Card wallet pages scroll with the page itself; the shared page scroller keeps
   its original settings (no extra enhanced / sticky modes), since changing how it
   behaves has frozen touch scrolling on iOS devices. */

/* Brew detail (view mode): a hero card in the bean's colours, four key numbers,
   a short equipment list, and the rarer fields behind a "更多参数" toggle. */
.log-detail-hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 30rpx 30rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(80, 58, 28, 0.08);
}

.log-detail-hero-title {
  color: #1f1a14;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.25;
}

.log-detail-hero-sub {
  color: #4b4135;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.45;
}

.log-detail-hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.log-detail-hero-foot .brew-record-rating-stars {
  gap: 8rpx;
}

.log-detail-hero-foot .brew-record-rating-star {
  font-size: 28rpx;
}

.log-detail-unrated {
  color: #8a7a64;
  font-size: 23rpx;
  font-weight: 650;
}

.log-detail-hero-date {
  color: #8a7a64;
  font-size: 22rpx;
  font-weight: 600;
}

.log-detail-key-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.log-detail-key {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(199, 150, 51, 0.18);
  border-radius: 24rpx;
  background: #ffffff;
}

.log-detail-key-label {
  color: #8a7a64;
  font-size: 22rpx;
  font-weight: 650;
}

.log-detail-key-value {
  overflow: hidden;
  color: #241b10;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-detail-key-sub {
  overflow: hidden;
  color: #a39782;
  font-size: 21rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-detail-list {
  padding: 4rpx 24rpx;
  border: 1rpx solid rgba(199, 150, 51, 0.18);
  border-radius: 24rpx;
  background: #ffffff;
}

.log-detail-list-row,
.log-detail-more-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 84rpx;
  border-bottom: 1rpx solid #f1eadc;
  font-size: 26rpx;
}

.log-detail-list-row > text:first-child,
.log-detail-more-toggle > text:first-child {
  flex: 0 0 auto;
  color: #8a7a64;
  font-weight: 600;
}

.log-detail-list-row > text:last-child {
  overflow: hidden;
  color: #241b10;
  font-weight: 700;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-detail-list-row.is-empty > text:last-child {
  color: #c4b8a4;
  font-weight: 500;
}

.log-detail-list > view:last-child,
.log-detail-more-toggle:last-child {
  border-bottom: 0;
}

.log-detail-more-toggle-hover {
  opacity: 0.7;
}

.log-detail-more-hint {
  color: #b88222;
  font-size: 23rpx;
  font-weight: 650;
}

.log-detail-more-arrow {
  display: inline-block;
  margin-left: 8rpx;
  transition: transform 160ms ease;
}

.log-detail-more-toggle.is-open .log-detail-more-arrow {
  transform: rotate(180deg);
}

/* The add action is a round button in the bottom-right corner instead of a
   full-width bar, so it no longer competes with buttons inside the cards. */
.fixed-add-action {
  right: 36rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  left: auto;
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: 0 12rpx 28rpx rgba(157, 104, 18, 0.32);
}

.fixed-add-action-fill {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  font-size: 54rpx;
  font-weight: 400;
}

.fixed-add-action-hover .fixed-add-action-fill {
  transform: scale(0.94);
}

/* Small fixes: unrated records, empty-state action, nickname placeholder. */
.log-wallet-unrated {
  color: #a39782;
  font-size: 23rpx;
  font-weight: 650;
}

.empty-state-action {
  align-self: center;
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #241b10;
  color: #fffdf8;
  font-size: 26rpx;
  font-weight: 700;
}

.empty-state-action-hover {
  opacity: 0.8;
}

.mine-nickname-placeholder {
  color: #c4b8a4;
  font-size: 30rpx;
  font-weight: 600;
}

.mine-record-summary {
  display: block;
  margin-top: 4rpx;
  color: #9d6812;
  font-size: 24rpx;
  font-weight: 700;
}

/* Leave room under the last card so it can scroll clear of the round add button. */
.beans-view.has-fixed-add-action,
.recipe-view.has-fixed-add-action {
  padding-bottom: 180rpx;
}

