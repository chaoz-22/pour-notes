  color: #ffffff;
  text-align: right;
}

.stats-total-value text {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
}

.stats-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.stats-mini-card,
.stats-chart-card {
  border: 1rpx solid rgba(197, 151, 62, 0.24);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(151, 111, 38, 0.1);
}

.stats-mini-card {
  display: grid;
  gap: 10rpx;
  min-height: 118rpx;
  padding: 22rpx;
  border-radius: 24rpx;
}

.stats-mini-card text:first-child {
  color: #7e715f;
  font-size: 22rpx;
  font-weight: 650;
}

.stats-mini-card text:last-child {
  color: #241b10;
  font-size: 34rpx;
  font-weight: 850;
}

.stats-chart-card {
  display: grid;
  gap: 24rpx;
  padding: 26rpx;
  border-radius: 28rpx;
}

.stats-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stats-card-heading > text:first-child {
  color: #241b10;
  font-size: 30rpx;
  font-weight: 850;
}

.stats-chart-period-trigger {
  display: flex;
  min-height: 44rpx;
  align-items: center;
  gap: 8rpx;
  color: #8d8578;
  font-size: 21rpx;
  font-weight: 650;
}

.stats-chart-period-arrow {
  display: block;
  color: #b88222;
  font-size: 25rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 180ms ease;
}

.stats-chart-period-arrow.is-open {
  transform: rotate(180deg);
}

.stats-trend-chart {
  display: flex;
  min-height: 250rpx;
  align-items: flex-end;
  gap: 12rpx;
  overflow-x: auto;
  padding: 8rpx 4rpx 2rpx;
}

.trend-bar-item {
  display: grid;
  flex: 1 0 46rpx;
  min-width: 46rpx;
  justify-items: center;
  gap: 8rpx;
  padding: 6rpx 3rpx 4rpx;
  border-radius: 16rpx;
  transition: background-color 160ms ease, box-shadow 160ms ease, opacity 120ms ease;
}

.trend-bar-item-hover {
  opacity: 0.78;
}

.trend-bar-item.is-active .trend-bar-fill {
  width: 32rpx;
  background: #9d6812;
  box-shadow: 0 6rpx 14rpx rgba(157, 104, 18, 0.24);
}

.trend-bar-item.is-active .trend-bar-label,
.trend-bar-item.is-active .trend-bar-sub-label {
